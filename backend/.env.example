# SmartPool Backend Firebase Admin & Server Configuration
# Copy this file to .env and configure:

# Path to Firebase Admin service account JSON file (download from Firebase Console -> Project Settings -> Service accounts -> Generate new private key)
# FIREBASE_SERVICE_ACCOUNT_KEY=./firebase-service-account.json
# or:
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# OR provide the raw JSON string directly (useful for production deployment on Render/Railway/Fly.io):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Project ID (optional if service account key is provided, or for emulator)
FIREBASE_PROJECT_ID=your_project_id

# Set to true or point to FIRESTORE_EMULATOR_HOST if using local Firebase Emulator
# FIRESTORE_EMULATOR_HOST=localhost:8080

# Server settings
PORT=8000
HOST=127.0.0.1
