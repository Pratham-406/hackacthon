rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'admin' ||
        request.auth.token.admin == true
      );
    }

    function isDriver() {
      return isAuthenticated() && (
        getUserData().role == 'driver' ||
        request.auth.token.driver == true
      );
    }

    // Collection: users
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Allow user to create/update their own profile without self-elevating to admin
      allow create: if isOwner(userId) && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role in ['passenger', 'driver']);
      allow update: if isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) || isAdmin());
      allow delete: if isAdmin();
    }

    // Collection: rides
    match /rides/{rideId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isDriver() || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isDriver() || isAdmin());
      allow delete: if isAdmin();
    }

    // Collection: drivers
    match /drivers/{driverId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(driverId) || isAdmin();
    }

    // Collection: dispatches
    match /dispatches/{dispatchId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Collection: trip_history
    match /trip_history/{historyId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }
  }
}
